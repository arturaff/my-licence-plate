<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/click"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.RandomFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        tools:ignore="UselessParent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/random"
            android:textSize="22sp" />

        <FrameLayout
            android:layout_width="334.255dp"
            android:layout_height="74.36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="175dp">

            <ImageView
                android:layout_width="334.255dp"
                android:layout_height="74.36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/license_plate" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="51dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="11dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_letter_1"
                    android:layout_width="33dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/letter_k" />

                <ImageView
                    android:id="@+id/image_number_1"
                    android:layout_width="32dp"
                    android:layout_height="51dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/number_5" />

                <ImageView
                    android:id="@+id/image_number_2"
                    android:layout_width="32dp"
                    android:layout_height="51dp"
                    android:layout_marginStart="3dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/number_7" />

                <ImageView
                    android:id="@+id/image_number_3"
                    android:layout_width="32dp"
                    android:layout_height="51dp"
                    android:layout_marginStart="3dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/number_3" />

                <ImageView
                    android:id="@+id/image_letter_2"
                    android:layout_width="33dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/letter_t" />

                <ImageView
                    android:id="@+id/image_letter_3"
                    android:layout_width="33dp"
                    android:layout_marginStart="3dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/letter_h" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="33dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="256dp"
                android:layout_marginBottom="28dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_region_1"
                    android:layout_width="20dp"
                    android:layout_height="33dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/region_6" />

                <ImageView
                    android:id="@+id/image_region_2"
                    android:layout_width="20dp"
                    android:layout_height="33dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/region_9" />

                <ImageView
                    android:id="@+id/image_region_3"
                    android:layout_width="20dp"
                    android:layout_height="33dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/region_7" />


            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

</FrameLayout>